{
  "name": "@land-digitization/server",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "test:data": "tsx tests/data-layer.test.ts",
    "test:api": "tsx tests/api-validation.test.ts",
    "test:auth": "tsx tests/auth-rbac.test.ts",
    "test:records": "tsx tests/records-crud.test.ts",
    "test:citizen": "tsx tests/citizen-workflow.test.ts",
    "test:documents": "tsx tests/document-management.test.ts",
    "test:ocr": "tsx tests/ocr-pipeline.test.ts",
    "test:extraction": "tsx --test tests/field-extraction.test.ts",
    "test:verification": "tsx --test tests/human-verification-workflow.test.ts",
    "test:validation": "tsx --test tests/validation-engine.test.ts",
    "test:duplicates": "tsx --test tests/duplicate-detection.test.ts",
    "test:gis": "tsx --test tests/gis-parcels.test.ts",
    "test:officer": "tsx --test tests/officer-portal.test.ts",
    "test:admin": "tsx --test tests/admin-portal.test.ts",
    "test:security": "tsx --test tests/security-reliability.test.ts",
    "test:e2e": "tsx --test tests/e2e-user-flows.test.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.12.0",
    "@land-digitization/shared": "*",
    "@prisma/client": "^5.14.0",
    "@turf/turf": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "tesseract.js": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "prisma": "^5.14.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
