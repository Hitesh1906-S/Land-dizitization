# Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/land_digitization_db?schema=public

# Authentication Secrets
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super_secret_refresh_token_key_change_in_production
REFRESH_TOKEN_EXPIRES_IN=7d

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# AI / OCR Configurations
GEMINI_API_KEY=
TESSERACT_LANG=eng+hin
